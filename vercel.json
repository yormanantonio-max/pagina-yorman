{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/catalogo", "destination": "/catalogo_quebrutal/index.html" },
    { "source": "/catalogo_quebrutal", "destination": "/catalogo_quebrutal/index.html" },
    { "source": "/quebrutal", "destination": "/catalogo_quebrutal/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
